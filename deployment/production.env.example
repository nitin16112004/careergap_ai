# CareerGuid AI production deployment environment
# Copy this file to .env.production on the production Docker host and replace every placeholder.
# Never commit the real .env.production file.

# Release images
REGISTRY=ghcr.io
IMAGE_NAMESPACE=nitin16112004
IMAGE_TAG=replace-with-main-commit-sha

# Public edge / TLS
APP_DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
TLS_CERT_FILE=/opt/careerguid-ai/tls/fullchain.pem
TLS_KEY_FILE=/opt/careerguid-ai/tls/privkey.pem

# Supabase Cloud
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-supabase-service-role-key

# Managed Redis (Upstash / Redis Cloud recommended)
# Use rediss:// when the provider supports TLS.
REDIS_URL=rediss://default:replace-me@redis.example.com:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Backend runtime
AI_REQUEST_TIMEOUT_MS=90000
HEALTHCHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Transactional email / weekly reminders
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_BASE_URL=https://api.resend.com
EMAIL_PROVIDER_API_KEY=replace-me-resend-api-key
EMAIL_FROM=CareerGuid AI <noreply@example.com>
REMINDER_CRON_PATTERN=0 0 9 * * 1
REMINDER_CRON_TIMEZONE=Asia/Kolkata
REMINDER_INACTIVE_DAYS=7
REMINDER_SCAN_BATCH_SIZE=500
REMINDER_EMAIL_JOB_ATTEMPTS=3
ACTIVITY_TOUCH_INTERVAL_SECONDS=300

# AI / RAG providers
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me-llm-api-key
LLM_MODEL=replace-me-llm-model
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me-embedding-api-key
EMBEDDING_MODEL=replace-me-embedding-model
RAG_EMBEDDING_DIMENSION=1536
AI_PROVIDER_TIMEOUT_SECONDS=45

# Billing provider. Configure the selected provider completely.
BILLING_DEFAULT_PROVIDER=razorpay
BILLING_WEBHOOK_TOLERANCE_SECONDS=300

# Razorpay
RAZORPAY_KEY_ID=replace-me-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-me-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-me-razorpay-webhook-secret

# Stripe (required instead when BILLING_DEFAULT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
