# Shared
NODE_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=
BACKEND_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000

# Supabase Project
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend
PORT=5000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-for-compose
REDIS_CONNECT_TIMEOUT_MS=5000
AI_REQUEST_TIMEOUT_MS=90000
HEALTHCHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
JWT_SECRET=

# Weekly reminders / transactional email v1.4
# Use console only for local development. Production reminder delivery should use resend.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_BASE_URL=https://api.resend.com
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
REMINDER_CRON_PATTERN=0 0 9 * * 1
REMINDER_CRON_TIMEZONE=UTC
REMINDER_INACTIVE_DAYS=7
REMINDER_SCAN_BATCH_SIZE=500
REMINDER_EMAIL_JOB_ATTEMPTS=3
ACTIVITY_TOUCH_INTERVAL_SECONDS=300

# AI Service / true RAG v1.2
AI_SERVICE_PORT=8000
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSION=1536
AI_PROVIDER_TIMEOUT_SECONDS=45

# Billing / upgrade
# Provider secrets are backend-only. Do not expose these through VITE_* variables.
BILLING_DEFAULT_PROVIDER=razorpay
BILLING_WEBHOOK_TOLERANCE_SECONDS=300

# Razorpay (India / INR checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (hosted subscription checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
